NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server only. Never prefix with NEXT_PUBLIC_ or expose in browser code.
SUPABASE_SERVICE_ROLE_KEY=

# Required to authorize the scheduled POST /api/cron/tracking-reminders job.
TRACKING_CRON_SECRET=

# Optional until Resend is configured. Email mode reports not_sent when absent.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
